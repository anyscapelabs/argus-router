# Better Auth signing/encryption secret (at least 32 chars)
BETTER_AUTH_SECRET=change-me-change-me-change-me-chang

# Public base URL of this API (used for auth links, callbacks, cookies)
BETTER_AUTH_URL=http://localhost:8080

# Dashboard origin (trusted origin + CORS + verification-link redirect target)
DASHBOARD_URL=http://localhost:3000

# Database — a single shared pool (max 5 conns)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Upstash Redis (serverless, REST). Without these, caching is disabled.
UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend). Without a key, verification emails are logged locally.
RESEND_API_KEY=
RESEND_FROM="Argus Agent <onboarding@resend.dev>"

# OAuth providers (optional; enabled only when both id and secret are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-held upstream origin key (OpenRouter fronts every model provider;
# proxying is Argus-held pre-BYOK). Omit it and inference serves 503
# provider_unconfigured; the models listing itself stays public.
OPENROUTER_API_KEY=
