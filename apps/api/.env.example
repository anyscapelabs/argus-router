# Better Auth signing/encryption secret (at least 32 chars)
BETTER_AUTH_SECRET=change-me-change-me-change-me-chang

# Public base URL of this API (used for auth links, callbacks, cookies)
BETTER_AUTH_URL=http://localhost:8080

# Dashboard origin (trusted origin + CORS + verification-link redirect target)
DASHBOARD_URL=http://localhost:3000

# Database — a single shared pool. Max connections default to 10; override
# for larger computes (clamped to 100). Neon's pooler caps per compute.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# API_DB_MAX_CONNECTIONS=10

# Operators allowed to refresh the shared model catalog / plan allowlists.
# Comma-separated user IDs and/or emails. If unset, nobody is an admin and
# the refresh endpoints are closed.
# ADMIN_USER_IDS=
# ADMIN_EMAILS=you@example.com

# Upstash Redis (serverless, REST). Without these, caching is disabled.
UPSTASH_REDIS_REST_URL=https://<your-redis>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Email (Resend). Without a key, verification emails are logged locally.
RESEND_API_KEY=
RESEND_FROM="Argus Agent <onboarding@resend.dev>"

# OAuth providers (optional; enabled only when both id and secret are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-held upstream origin key (OpenRouter fronts every model provider;
# proxying is Argus-held pre-BYOK). Omit it and inference serves 503
# provider_unconfigured; the models listing itself stays public.
OPENROUTER_API_KEY=

# OpenRouter app attribution (shown in OpenRouter rankings/analytics instead of "Unknown")
# OPENROUTER_APP_TITLE defaults to "Argus Agent"
# OPENROUTER_APP_URL defaults to DASHBOARD_URL when unset
# OPENROUTER_APP_TITLE=Argus Agent
# OPENROUTER_APP_URL=https://your-app-domain.example

# Google Gemini API key (for Gemini 3.8 Live Speech-to-Speech WebSockets)
GEMINI_API_KEY=

# Dodo Payments billing (optional until paid plans are enabled)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/console/settings/billing
# BILLING_PRODUCTS_PATH=/absolute/path/to/products.json

# Web search providers. The router routes each query across whichever of these
# are configured, with automatic fallback on failure. At least one is required
# for the /v1/search endpoint.
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
