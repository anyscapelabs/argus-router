# Argus LLM Gateway — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.

# OpenRouter API key — single key for all LLM providers
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Internal service-to-service key
# Generate a random string: openssl rand -hex 32
# This key is used by the Rust gateway to authenticate requests to this service
# NEVER expose this key publicly — it has no per-user auth
LITELLM_INTERNAL_KEY=sk-internal-generate-a-strong-random-key-here
